{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Installable desktop shell for the DeepSeek Harness Web UI",
  "author": "DeepSeek AI",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist:win": "node scripts/dist-win.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-session-telemetry": "workspace:^",
    "@deepseek-ai/dsh-session-title-llm": "workspace:^",
    "@deepseek-ai/dsh-spill": "workspace:^",
    "dsh-jsonrpc-agent-pkg": "workspace:*"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "C:\\Users\\USTC\\Downloads\\deepseek-harness-master\\deepseek-harness-master\\apps\\desktop\\dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis",
      "artifactName": "DeepSeek-Harness-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    }
  }
}
