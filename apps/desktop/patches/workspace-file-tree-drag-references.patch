+/** Resolve a current-Session workspace-file drag into the composer's reference form. */
+export function workspaceFileDropReference(
+  sessionId: string,
+  address: string,
+): ReferenceInsert | undefined {
+  const file = parseFileAddress(address)
+  if (file?.scope !== 'session' || file.sessionId !== sessionId
+    || file.path === '' || isAbsoluteWorkspacePath(file.path)) return undefined
+  const mention = formatFileMention({ kind: 'file', path: file.path }, false)
+  if (mention === undefined) return undefined
+  return {
+    source: 'reference',
+    ref: mention,
+    label: pathPartsOf(file.path).name,
+    appearance: 'file',
+    clipboardText: mention,
+  }
+}
